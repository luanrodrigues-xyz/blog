---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../lib/projects';
---

<BaseLayout
  title="Projects"
  description="Development notes and ongoing work on Vetra, Tessora, Ruptura, Unsealed and Deploy ou Ruína."
  language="en"
>
  <div class="projects-page">
    <header class="page-header">
      <h1>Projects</h1>
      <p class="lead">Games, tools and experiments I'm working on. I keep the technical decisions and the rough edges here, not just polished screenshots.</p>
    </header>
    {projects.map((project) => (
      <section id={project.slug} class="project-entry" aria-labelledby={`title-${project.slug}`}>
        <p class="project-kind">{project.kind} · {project.stack}</p>
        <h2 id={`title-${project.slug}`}>{project.title}</h2>
        <p class="project-summary">{project.summary}</p>
        <p>{project.details}</p>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .projects-page { padding-bottom: var(--space-12); }
  .project-entry { padding: var(--space-8) 0; border-top: 1px solid var(--border); scroll-margin-top: 6rem; }
  .project-entry h2 { margin: 0 0 0.75rem; font: 700 1.6rem/1.25 var(--font-heading); }
  .project-entry p { line-height: 1.7; color: var(--fg-muted); }
  .project-entry .project-summary { color: var(--fg); font-size: 1.05rem; }
  .project-kind { margin: 0 0 0.75rem; font: 0.8rem/1.5 var(--font-mono); }
</style>
