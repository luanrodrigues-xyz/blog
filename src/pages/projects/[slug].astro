---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects, type Project } from '../../lib/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<BaseLayout
  title={project.title}
  description={project.summary}
  language="en"
>
  <article class="project-detail">
    <nav class="project-breadcrumb" aria-label="Breadcrumb">
      <a href="/projects/">Projects</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{project.title}</span>
    </nav>

    <header class="project-hero">
      <p class="project-kind">{project.kind}</p>
      <h1>{project.title}</h1>
      <p class="project-lead">{project.summary}</p>
      <p class="project-stack">{project.stack}</p>
    </header>

    <section class="project-section" aria-labelledby="overview">
      <h2 id="overview">What I'm building</h2>
      <p>{project.details}</p>
    </section>

    <section class="project-section" aria-labelledby="journal">
      <h2 id="journal">Development log</h2>
      <p>Notes on implementation, profiling, design decisions and experiments will live here as the project evolves.</p>
    </section>

    <section class="project-section" aria-labelledby="media">
      <h2 id="media">Screenshots and playtests</h2>
      <p>Visual comparisons and test results will be added when there's material worth showing.</p>
    </section>

    <a class="project-back" href="/projects/">← Back to projects</a>
  </article>
</BaseLayout>

<style>
  .project-detail { padding: var(--space-6) 0 var(--space-12); }
  .project-breadcrumb { display: flex; align-items: center; gap: .65rem; color: var(--fg-muted); font-size: .875rem; }
  .project-breadcrumb a { color: inherit; }
  .project-hero { padding: var(--space-10) 0 var(--space-8); }
  .project-kind { margin: 0 0 var(--space-3); color: var(--fg-muted); font: .8rem/1.5 var(--font-mono); text-transform: uppercase; letter-spacing: .06em; }
  .project-hero h1 { margin: 0 0 var(--space-4); font: 700 clamp(2.5rem, 7vw, 3.5rem)/1.08 var(--font-heading); letter-spacing: -.035em; }
  .project-lead { margin: 0 0 var(--space-5); font-size: clamp(1.15rem, 3vw, 1.35rem); line-height: 1.55; color: var(--fg-muted); }
  .project-stack { margin: 0; color: var(--fg-muted); font: .85rem/1.6 var(--font-mono); }
  .project-section { border-top: 1px solid var(--border); padding: var(--space-7) 0; }
  .project-section h2 { margin: 0 0 var(--space-4); font: 700 1.35rem/1.3 var(--font-heading); }
  .project-section p { margin: 0; color: var(--fg-muted); line-height: 1.75; }
  .project-back { display: inline-block; margin-top: var(--space-5); }
</style>
