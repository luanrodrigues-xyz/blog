---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { games } from '../../../../data/games';

type JournalEntry = CollectionEntry<'gameJournal'>;

export async function getStaticPaths() {
  const entries = await getCollection('gameJournal', ({ data }) => !data.draft);
  return entries
    .filter((entry) => games.some((game) => game.slug === entry.data.game))
    .map((entry) => ({
      params: { game: entry.data.game, entry: entry.id.split('/').at(-1) },
      props: { entry },
    }));
}

const { entry } = Astro.props as { entry: JournalEntry };
const game = games.find((item) => item.slug === entry.data.game)!;
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.summary} language="en" isListingPage>
  <article class="game-detail game-journal-entry">
    <p class="game-detail__breadcrumb">
      <a href={`/games/${game.slug}/`}>{game.title}</a> /
      <a href={`/games/${game.slug}/journal/`}>Development journal</a>
    </p>
    <h1>{entry.data.title}</h1>
    <div class="game-journal__meta">
      <time datetime={entry.data.date.toISOString().slice(0, 10)}>{entry.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time>
      {entry.data.version && <span>{entry.data.version}</span>}
    </div>
    <p class="game-detail__lead">{entry.data.summary}</p>
    <div class="game-journal-entry__body"><Content /></div>
    <p class="game-journal-entry__back"><a href={`/games/${game.slug}/journal/`}>← All updates</a></p>
  </article>
</BaseLayout>
