---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { formatDate } from '../../../../config/site';
import { games, gameUrl } from '../../../../data/games';

export async function getStaticPaths() {
  const entries = await getCollection('gameJournal', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { game: entry.data.game, entry: entry.id.split('/').at(-1) },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'gameJournal'> };
const game = games.find((item) => item.slug === entry.data.game)!;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary} ogType="article">
  <article class="section" aria-labelledby="entry-title">
    <div class="shell">
      <div class="stack" style="max-width: 68ch">
        <a class="eyebrow" href={`/games/${game.slug}/journal/`}>
          {game.title} / Dev journal
        </a>
        <h1 class="display-l" id="entry-title">
          {entry.data.title}
        </h1>
        <div class="btn-group" style="align-items: center">
          <time class="badge" datetime={entry.data.date.toISOString().slice(0, 10)}>
            {formatDate(entry.data.date)}
          </time>
          {entry.data.version && <span class="chip">{entry.data.version}</span>}
        </div>
        <p class="lead">{entry.data.summary}</p>
      </div>
      <div class="prose">
        <Content />
      </div>
      <p>
        <a href={gameUrl(game)}>← Back to {game.title}</a>
      </p>
    </div>
  </article>
</BaseLayout>
