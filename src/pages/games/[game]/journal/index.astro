---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import JournalList from '../../../../components/games/JournalList.astro';
import SectionHeading from '../../../../components/ui/SectionHeading.astro';
import { games, gameUrl, type Game } from '../../../../data/games';
import { publishedJournal } from '../../../../lib/game-journal';

export function getStaticPaths() {
  return games.map((game) => ({ params: { game: game.slug }, props: { game } }));
}

const { game } = Astro.props as { game: Game };
const journal = await publishedJournal(game.slug);
---

<BaseLayout title={`${game.title} — Dev journal`} description={`Development updates for ${game.title}.`}>
  <section class="section" aria-labelledby="journal-title">
    <div class="shell">
      <SectionHeading as="h1" eyebrow={`${game.title} / Dev journal`} title="Every update" id="journal-title">
        <a href={gameUrl(game)}>← Back to {game.title}</a>
      </SectionHeading>
      <JournalList entries={journal} withSummary empty="No development updates have been published yet." />
    </div>
  </section>
</BaseLayout>
