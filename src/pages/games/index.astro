---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/games/GameCard.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { games } from '../../data/games';
---

<BaseLayout
  title="Games"
  description="Independent 2D games by Luan Rodrigues: puzzles, platformers and narrative experiments."
>
  <section class="section" aria-labelledby="games-title">
    <div class="shell">
      <SectionHeading as="h1" eyebrow="Level select" title="Games in the workshop" id="games-title">
        <p>
          Independent 2D games, from geometric puzzles to precision platformers and narrative experiments — each with a
          dev journal.
        </p>
      </SectionHeading>
      <div class="grid" style="--grid-min: 320px">
        {games.map((game) => (
          <GameCard game={game} headingLevel="h2" />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
