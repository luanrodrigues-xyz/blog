---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { keyArt } from '../data/art';

const artSkills = ['Character design', 'Comic strips', 'Visual development', 'Digital illustration'];
const codeSkills = ['C++20', 'SDL3', 'TypeScript', 'PixiJS', 'React'];
---

<BaseLayout title="About" description="Luan Rodrigues: concept artist, illustrator and independent game developer.">
  <section class="section dots" aria-labelledby="about-title">
    <div class="shell split">
      <div class="stack">
        <span class="eyebrow">About</span>
        <h1 class="display-xl" id="about-title">
          Hi, I'm <span class="highlight">Luan</span>
        </h1>
        <p class="bubble bubble--left">Concept artist, illustrator and independent game developer.</p>
        <div class="prose">
          <p>
            I work on character design, visual development and digital illustration. <strong>Deploy ou Ruína</strong> is
            my original project about Carlos and the absurdities of working in technology.
          </p>
          <p>
            I also build independent games — puzzles and platformers in TypeScript, PixiJS, C++ and SDL3. My
            professional background is in software development, which is why the developer side keeps showing up in the
            art.
          </p>
        </div>
      </div>
      <figure class="panel panel--hero">
        <Image
          src={keyArt.image}
          alt={keyArt.alt}
          widths={[480, 800]}
          sizes="(max-width: 900px) calc(100vw - 32px), 560px"
          loading="eager"
        />
      </figure>
    </div>
  </section>

  <section class="section section--concrete" aria-labelledby="toolkit-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Two toolkits, one world</span>
          <h2 class="display-l" id="toolkit-title">
            Pencil &amp; compiler
          </h2>
        </div>
      </div>
      <div class="grid" style="--grid-min: 340px; --grid-gap: 28px">
        <div class="card toolkit">
          <h3>Art</h3>
          <ul class="pills">
            {artSkills.map((skill) => (
              <li class="pill">{skill}</li>
            ))}
          </ul>
        </div>
        <div class="card toolkit">
          <h3>Code</h3>
          <ul class="chips">
            {codeSkills.map((skill) => (
              <li class="chip toolkit__chip">{skill}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .toolkit {
    gap: 14px;
    padding: 28px;
    box-shadow: var(--shadow-m);
  }

  .toolkit h3 {
    font-size: 2rem;
  }

  .toolkit__chip {
    padding: 6px 12px;
    font-size: 0.875rem;
  }
</style>
