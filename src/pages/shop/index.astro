---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGrid from '../../components/shop/ProductGrid.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { site } from '../../config/site';
---

<BaseLayout
  title="Shop"
  description="Original stickers, T-shirts and mugs by Art by Luan. First collection in preparation."
>
  <section class="section" aria-labelledby="shop-title">
    <div class="shell">
      <SectionHeading as="h1" eyebrow="Merch stand · Coming soon" title="Art for everyday life" id="shop-title">
        <p>
          The first collection starts with original artwork from Deploy ou Ruína. Product designs, prices and shipping
          details will be announced before orders open.
        </p>
      </SectionHeading>
      <ProductGrid headingLevel="h2" />
    </div>
  </section>

  <section class="section section--concrete" aria-labelledby="follow-title">
    <div class="shell split">
      <div class="stack">
        <span class="eyebrow">Be first in line</span>
        <h2 class="display-l" id="follow-title">
          Follow the first collection
        </h2>
        <p class="lead">New artwork and product announcements land on Instagram first.</p>
      </div>
      <div>
        <a class="btn btn--primary" href={site.instagram}>
          Follow @artbyluan
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
