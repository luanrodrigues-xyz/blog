---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
---

<BaseLayout title="Page not found" description="This page could not be found." canonical={null} noindex>
  <section class="section dots" aria-labelledby="not-found-title">
    <div class="shell split">
      <div class="stack">
        <span class="sticker">Error 404</span>
        <h1 class="display-xl" id="not-found-title">
          Wrong <span class="highlight">stairway</span>
        </h1>
        <p class="bubble bubble--left">This page doesn't exist in Silicon City.</p>
        <p class="lead">
          The address may have changed. The old technical articles were retired when the site became a portfolio.
        </p>
        <div class="btn-group">
          <a class="btn btn--primary" href="/">
            Back home <Icon name="arrow" />
          </a>
          <a class="btn" href="/games/">
            See the games
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
