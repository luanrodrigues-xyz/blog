---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
---

<BaseLayout title="Page not found" description="This page could not be found." canonical={null} noindex>
  <section class="section dots" aria-labelledby="not-found-title">
    <div class="shell split">
      <div class="stack">
        <span class="sticker">Error 404</span>
        <h1 class="display-xl" id="not-found-title">
          Wrong <span class="highlight">stairway</span>
        </h1>
        <p class="lead">
          The address may have changed. The old technical articles were retired when the site became a portfolio.
        </p>
        <div class="btn-group" style="margin-top: 8px">
          <a class="btn btn--primary" href="/">
            Back home <Icon name="arrow" />
          </a>
          <a class="btn" href="/games/">
            See the games
          </a>
        </div>
      </div>
      <div class="lost">
        <div class="panel panel--hero lost__panel">
          <svg viewBox="0 0 200 200" aria-hidden="true">
            <path class="lost__steps" d="M0 170 H40 V145 H80 V120 H120 V95 H160 V70 H200 V200 H0 Z"></path>
            <path d="M40 145 V170 M80 120 V145 M120 95 V120 M160 70 V95"></path>
            <path d="M150 70 V30 H190 M160 70 V40 M178 70 V40"></path>
            <rect class="lost__sign" x="20" y="24" width="96" height="44" rx="4"></rect>
            <text x="68" y="55" text-anchor="middle">
              404
            </text>
            <path d="M68 68 V92"></path>
          </svg>
          <p class="bubble lost__bubble">This page doesn't exist in Silicon City.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    flex: 1 1 360px;
    display: flex;
    justify-content: center;
  }

  .lost__panel {
    width: min(100%, 420px);
    aspect-ratio: 1;
    transform: rotate(1.5deg);
  }

  .lost__panel svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--ink);
    stroke-width: 4;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .lost__steps {
    fill: var(--concrete);
  }

  .lost__sign {
    fill: var(--paper-raised);
  }

  .lost__panel text {
    fill: var(--ink);
    stroke: none;
    font-family: var(--font-display);
    font-size: 24px;
  }

  .lost__bubble {
    position: absolute;
    right: 14px;
    top: 14px;
    max-width: 11rem;
    font-size: 0.9375rem;
  }
</style>
