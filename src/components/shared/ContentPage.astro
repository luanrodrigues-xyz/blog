---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../home/HomePage.astro';
import { languageOf, ui } from '../../config/site';
import { articleCover, socialCover } from '../../lib/covers';

interface Props {
  entry: CollectionEntry<'sitePages'>;
}

const { entry } = Astro.props;
const { data } = entry;
const language = languageOf(data.language);
const { Content } = await render(entry);
const isHome = data.isHome === true;
const isAbout = data.isAbout === true;
const isLab = data.isLab === true;
const title = data.title ?? (isAbout ? ui.about : isLab ? ui.lab : ui.home);
const description = data.description ?? '';
const cover = await articleCover(data.cover);
---

<BaseLayout
  title={title}
  description={description}
  language={language}
  coverUrl={socialCover(data.cover)}
  coverAlt={data.coverAlt}
  canonical={data.canonical}
  alternates={data.alternates}
  ogType={data.ogType}
  isHome={isHome}
  isAbout={isAbout}
  isLab={isLab}
>
  {isHome ? (
    <HomePage entry={entry} />
  ) : (
    <div class:list={{ about: isAbout, prose: isAbout, lab: isLab }}>
      {cover ? (
        <picture class="cover-picture">
          {cover.dark && (
            <source
              srcset={cover.dark.srcSet.attribute || cover.dark.src}
              type="image/webp"
              sizes="(max-width: 927px) calc(100vw - 48px), 880px"
              media="(prefers-color-scheme: dark)"
            />
          )}
          <Image
            class="article-cover"
            loading="eager"
            src={cover.src}
            widths={[320, 640, 960, 1200]}
            sizes="(max-width: 927px) calc(100vw - 48px), 880px"
            alt={data.coverAlt ?? ''}
            width={cover.width}
            height={cover.height}
          />
        </picture>
      ) : (
        data.photo && <Image class="about-photo" src={data.photo} alt={data.photoAlt ?? ''} width="96" height="96" />
      )}
      <Content />
    </div>
  )}
</BaseLayout>
