---
import { Image } from 'astro:assets';
import type { Article } from '../../lib/articles';
import { articleUrl, interfaceLanguage } from '../../config/site';
import { topics } from '../../lib/topics';
import { articleCover } from '../../lib/covers';
import CategoryBadge from './CategoryBadge.astro';
interface Props {
  articles: Article[];
  headingLevel?: 'h2' | 'h3';
  showCategoryBadge?: boolean;
  eagerCount?: number;
}
const { articles, headingLevel: Heading = 'h2', showCategoryBadge = true, eagerCount = 3 } = Astro.props;
const rows = await Promise.all(
  articles.map(async (article) => ({
    article,
    cover: await articleCover(article.data.cover),
    topic: topics.find((item) => item.slug === article.data.topic),
  })),
);
---

<ol class="publications" role="list">
  {rows.map(({ article, cover, topic }, index) => (
    <li class:list={['publication', { 'has-cover': Boolean(cover) }]}>
      {cover && (
        <a
          class="publication-cover"
          href={articleUrl(article)}
          aria-label={article.data.title}
          lang={article.data.language}
          tabindex="-1"
        >
          <picture>
            {cover.dark && (
              <source
                srcset={cover.dark.srcSet.attribute || cover.dark.src}
                type="image/webp"
                sizes="(max-width: 599px) calc(100vw - 48px), 250px"
                media="(prefers-color-scheme: dark)"
              />
            )}
            <Image
              src={cover.src}
              widths={[320, 640, 960, 1200]}
              sizes="(max-width: 599px) calc(100vw - 48px), 250px"
              alt=""
              width={cover.width}
              height={cover.height}
              loading={index < eagerCount ? 'eager' : 'lazy'}
              priority={index === 0 && eagerCount > 0}
            />
          </picture>
        </a>
      )}
      <div class="publication-body">
        <div class="publication-labels" lang={interfaceLanguage}>
          {showCategoryBadge && topic && <CategoryBadge topic={topic} />}
        </div>
        <Heading class="publication-title">
          <a href={articleUrl(article)} lang={article.data.language}>
            {article.data.title}
          </a>
        </Heading>
        <p lang={article.data.language}>{article.data.description}</p>
        <div class="publication-meta" lang={interfaceLanguage}>
          <time datetime={article.data.date.toISOString().slice(0, 10)}>{article.data.displayDate}</time>
          <span>{article.data.readingMinutes} min</span>
        </div>
      </div>
    </li>
  ))}
</ol>
<style>
  .publication-labels {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }
  .publications {
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .publication {
    display: grid;
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .publication.has-cover {
    grid-template-columns: 15.625rem minmax(0, 1fr);
    align-items: stretch;
  }
  .publication-cover {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-m);
    border: 1px solid var(--border);
  }
  picture,
  img {
    display: block;
    width: 100%;
  }
  img {
    height: auto;
  }
  @media (min-width: 600px) {
    .publication-cover {
      position: relative;
    }
    .publication-cover picture {
      position: absolute;
      inset: 0;
      height: 100%;
    }
    .publication-cover img {
      height: 100%;
      object-fit: cover;
    }
  }
  .publication-body {
    min-width: 0;
  }
  .publication-title {
    margin: 0.65rem 0 0.4rem;
    font: 700 1.25rem/1.3 var(--font-heading);
    letter-spacing: -0.025em;
  }
  .publication-title a {
    color: var(--fg);
    text-decoration: none;
  }
  .publication-title a:hover {
    color: var(--action);
    text-decoration: underline;
  }
  .publication-body p {
    margin: 0;
    color: var(--fg-muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .publication-meta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
    color: var(--fg-muted);
    font: 0.75rem/1.4 var(--font-mono);
  }
  @media (max-width: 599px) {
    .publication.has-cover {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>
