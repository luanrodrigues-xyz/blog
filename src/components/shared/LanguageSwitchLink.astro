---
// Reader-visible PT/EN toggle. `alternates` always self-references the current article (see
// lib/articles.ts). Missing or draft translations are shown without a link.
interface Alternate {
  language: string;
  url: string;
}

interface Props {
  alternates: Alternate[];
  language: string;
}

const { alternates, language } = Astro.props;

const autonym: Record<string, string> = {
  en: 'English',
  'pt-BR': 'Português',
};

const target = alternates.find((item) => item.language !== language);
const otherLanguage = language === 'en' ? 'pt-BR' : 'en';
const label = autonym[otherLanguage];
const shortLabel = (value: string) => (value === 'en' ? 'EN' : 'PT');
---

<span class="language-current" title={autonym[language]}>
  {shortLabel(language)}
</span>
{target && label ? (
  <a
    class="language-switch"
    href={target.url}
    hreflang={target.language}
    lang={target.language}
    aria-label={`Read this article in ${label}`}
  >
    <svg class="language-switch__icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6" />
      <path d="M3 12h18" fill="none" stroke="currentColor" stroke-width="1.6" />
      <path
        d="M12 3c2.5 2.6 3.8 5.8 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.8-3.8-9s1.3-6.4 3.8-9Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
      />
    </svg>
    <span class="language-switch__label">
      {shortLabel(target.language)} · {label}
    </span>
  </a>
) : (
  <span class="language-switch language-switch--pending" lang={language}>
    {language === 'pt-BR' ? 'English · Em tradução' : 'Português · Translation pending'}
  </span>
)}

<style>
  .language-current {
    align-self: center;
    font-weight: 600;
  }
  .language-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;

    padding: 0.3rem 0.7rem;

    color: var(--fg);
    background: color-mix(in srgb, var(--apple-blue) 16%, var(--canvas));

    border: 0;
    border-radius: 999px;

    font: 600 0.8rem/1.2 var(--font-ui);
    letter-spacing: -0.01em;
    text-decoration: none;

    white-space: nowrap;

    transition:
      background-color 160ms ease,
      outline-color 160ms ease;
  }

  .language-switch--pending {
    color: var(--fg-muted);
    background: var(--apple-gray6);
    white-space: normal;
  }

  .language-switch__icon {
    flex: 0 0 auto;
  }

  a.language-switch:hover {
    background: color-mix(in srgb, var(--apple-blue) 21%, var(--canvas));
    text-decoration: none;
  }

  a.language-switch:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--apple-blue) 30%, transparent);
    outline-offset: 3px;
  }

  @media (prefers-color-scheme: dark) {
    .language-switch {
      background: color-mix(in srgb, var(--apple-blue) 18%, var(--apple-gray6));
    }

    a.language-switch:hover {
      background: color-mix(in srgb, var(--apple-blue) 24%, var(--apple-gray6));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .language-switch {
      transition: none;
    }
  }
</style>
