---
import { isCurrent, navigation, site } from '../../config/site';
const { pathname } = Astro.url;
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="wordmark" href="/" aria-label={`${site.name} — home`}>
      <span class="wordmark__mark" aria-hidden="true">
        &lt;/&gt;
      </span>
      <span class="wordmark__name">{site.name}</span>
    </a>
    <nav aria-label="Main navigation">
      <ul>
        {navigation.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(pathname, item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--paper);
    border-bottom: var(--outline);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: 14px;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink);
    text-decoration: none;
  }

  .wordmark__mark {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: var(--orange);
    border: var(--outline);
    border-radius: var(--radius-m);
    box-shadow: 3px 3px 0 var(--ink);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9375rem;
    transition: transform 0.12s ease;
  }

  .wordmark:hover .wordmark__mark {
    transform: rotate(-6deg);
  }

  .wordmark__name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: var(--radius-s);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    background: var(--ink);
    color: var(--paper);
  }
</style>
