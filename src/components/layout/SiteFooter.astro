---
import { site } from '../../config/site';
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div class="site-footer__top">
      <p class="site-footer__title">
        See you in <span>Silicon City.</span>
      </p>
      <nav aria-label="Channels">
        <ul>
          {site.links.map((link) => (
            <li>
              <a href={link.href} rel="me">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <svg class="site-footer__city" viewBox="0 0 1200 90" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 90 V60 H60 V30 H110 V50 H150 V12 H190 V44 H250 V58 H300 V22 H330 V8 H360 V22 H390 V64 H460 V40 H520 V70 H580 V34 H620 V18 H680 V48 H740 V62 H800 V28 H850 V50 H910 V16 H960 V40 H1010 V66 H1070 V36 H1130 V54 H1200 V90 Z"></path>
    </svg>
    <p class="site-footer__legal">
      © {new Date().getUTCFullYear()} {site.name} · {site.tagline}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--paper);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
    padding-block: clamp(56px, 7vw, 88px) var(--space-6);
  }

  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .site-footer__title {
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .site-footer__title span {
    color: var(--orange);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 20px;
    border: var(--line-thin) solid var(--paper);
    border-radius: var(--radius-m);
    color: var(--paper);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
  }

  a:hover {
    background: var(--paper);
    color: var(--ink);
  }

  .site-footer__city {
    width: 100%;
    height: 72px;
    fill: var(--city);
  }

  .site-footer__legal {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--on-ink-muted);
  }
</style>
