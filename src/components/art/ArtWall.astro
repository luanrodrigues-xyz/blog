---
import { Image } from 'astro:assets';
import { keyArt, sketchbook } from '../../data/art';
import { site } from '../../config/site';
---

<div class="art-wall">
  <figure class="panel art-wall__key">
    <Image
      src={keyArt.image}
      alt={keyArt.alt}
      widths={[480, 800, 1200]}
      sizes="(max-width: 700px) calc(100vw - 32px), 760px"
      loading="lazy"
    />
    <figcaption class="panel__caption">
      <strong>{keyArt.title}</strong>
      <span>{keyArt.caption}</span>
    </figcaption>
  </figure>
  {sketchbook.map((shelf) => (
    <a class:list={['panel', 'dots', 'art-wall__shelf', `panel--${shelf.panel ?? 'raised'}`]} href={site.instagram}>
      <span class="art-wall__soon">On Instagram</span>
      <span class="art-wall__title">{shelf.title}</span>
      <span class="art-wall__caption">{shelf.caption}</span>
    </a>
  ))}
</div>

<style>
  .art-wall {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    grid-auto-flow: dense;
    gap: var(--space-5);
  }

  .art-wall__key {
    grid-column: span 2;
    grid-row: span 2;
    min-height: 420px;
    box-shadow: var(--shadow-l);
  }

  @media (max-width: 620px) {
    .art-wall__key {
      grid-column: auto;
      min-height: 340px;
    }
  }

  .art-wall__key img {
    position: absolute;
    inset: 0;
    object-position: 50% 40%;
  }

  .art-wall__shelf {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-1);
    min-height: 220px;
    padding: var(--space-4);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease;
  }

  .art-wall__shelf:hover {
    color: var(--ink);
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-l);
  }

  .art-wall__soon {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    padding: 5px 9px;
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-s);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .art-wall__title {
    font-family: var(--font-display);
    font-size: 1.625rem;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .art-wall__caption {
    font-weight: 700;
    font-size: var(--text-s);
  }
</style>
