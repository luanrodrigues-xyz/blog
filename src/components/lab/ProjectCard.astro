---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ui } from '../../config/site';

interface Props {
  title: string;
  description: string;
  href: string;
  tags: string[];
  accent?: string;
  media?: { src: ImageMetadata; alt: string } | { src: string; alt: string; width: number; height: number };
}

const { title, description, href, tags, accent = 'blue', media } = Astro.props;
---

<article class="project-card" style={`--card-accent: var(--apple-${accent})`}>
  <div class="project-card__media">
    {media ? (
      'width' in media ? (
        <Image src={media.src} alt={media.alt} width={media.width} height={media.height} loading="lazy" />
      ) : (
        <Image src={media.src} alt={media.alt} loading="lazy" />
      )
    ) : (
      <p class="project-card__media-placeholder">Preview coming soon</p>
    )}
  </div>
  <div class="project-card__body">
    <h3 class="project-card__title">{title}</h3>
    <p class="project-card__description">{description}</p>
    <ul class="project-card__tags" role="list">
      {tags.map((tag) => (
        <li class="project-tag">{tag}</li>
      ))}
    </ul>
    <a class="project-card__link" href={href} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.17c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .5Z"></path>
      </svg>
      {ui.viewOnGitHub}
    </a>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--canvas);
    box-shadow: 0 0 0 1px transparent;
    transition: border-color 160ms ease;
  }

  .project-card:hover {
    border-color: color-mix(in srgb, var(--card-accent) 45%, var(--border));
  }

  .project-card__media {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 10;
    background: color-mix(in srgb, var(--card-accent) 10%, var(--surface));
    border-bottom: 1px solid var(--border);
  }

  .project-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card__media-placeholder {
    margin: 0;
    padding: 0 var(--space-4);
    color: var(--fg-muted);
    font: 0.8125rem/1.4 var(--font-ui);
    text-align: center;
  }

  .project-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  .project-card__title {
    margin: 0;
    font: 700 1.0625rem/1.3 var(--font-heading);
    letter-spacing: -0.015em;
  }

  .project-card__description {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }

  .project-tag {
    padding: 0.2rem 0.6rem;
    color: var(--fg);
    background: color-mix(in srgb, var(--card-accent) 14%, var(--canvas));
    border-radius: 999px;
    font: 600 0.75rem/1.3 var(--font-mono);
    letter-spacing: -0.01em;
  }

  .project-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: var(--space-3);
    color: var(--fg);
    font: 600 0.875rem/1.3 var(--font-ui);
    text-decoration: none;
  }

  .project-card__link svg {
    width: 1rem;
    height: 1rem;
  }

  .project-card__link:hover {
    color: var(--action);
    text-decoration: underline;
  }

  @media (prefers-color-scheme: dark) {
    .project-tag {
      background: color-mix(in srgb, var(--card-accent) 20%, var(--apple-gray6));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }
  }
</style>
