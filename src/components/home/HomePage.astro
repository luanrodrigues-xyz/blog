---
import type { CollectionEntry } from 'astro:content';
import { projects } from '../../lib/projects';

interface Props {
  entry: CollectionEntry<'sitePages'>;
}

const { entry } = Astro.props;
---

<section class="home-intro">
  <h1>{entry.data.heroTitle}</h1>
  <p class="lead">{entry.data.intro ?? entry.data.description}</p>
  {entry.data.introDetail && <p class="lead">{entry.data.introDetail}</p>}
</section>

<section class="home-projects" aria-labelledby="projects-title">
  <div class="notes-head">
    <h2 id="projects-title">Projects</h2>
    <a href="/projects/">All projects →</a>
  </div>
  <div class="project-showcase">
    {projects.map((project) => (
      <a class="showcase-card" href={`/projects/#${project.slug}`}>
        <span class="showcase-kind">{project.kind}</span>
        <h3>{project.title}</h3>
        <p>{project.summary}</p>
        <span class="showcase-stack">{project.stack}</span>
      </a>
    ))}
  </div>
</section>

<section class="home-notes" aria-labelledby="notes-title">
  <h2 id="notes-title">Development notes</h2>
  <p>I'm using this space to keep track of the work behind the projects: design decisions, profiling, bugs, experiments and playtests. Not everything here is finished.</p>
  <a href="/projects/">See what I'm working on →</a>
</section>

<style>
  .home-projects { margin-bottom: var(--space-10); }
  .project-showcase { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .showcase-card { display: flex; flex-direction: column; gap: 0.75rem; padding: 1.5rem; border: 1px solid var(--border); border-radius: var(--radius-l); background: var(--canvas); text-decoration: none; color: var(--fg); }
  .showcase-card:hover { border-color: var(--action); }
  .showcase-kind, .showcase-stack { color: var(--fg-muted); font: 0.75rem/1.4 var(--font-mono); }
  .showcase-kind { text-transform: uppercase; letter-spacing: 0.07em; }
  .showcase-card h3 { margin: 0; font: 700 1.3rem/1.25 var(--font-heading); }
  .showcase-card p { margin: 0; color: var(--fg-muted); line-height: 1.6; flex: 1; }
  .home-notes { margin-bottom: var(--space-12); }
  .home-notes h2 { font-size: 1.3rem; }
  .home-notes p { color: var(--fg-muted); line-height: 1.7; }
  @media (max-width: 599px) { .project-showcase { grid-template-columns: 1fr; } }
</style>
