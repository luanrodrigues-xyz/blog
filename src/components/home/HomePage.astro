---
import type { CollectionEntry } from 'astro:content';
import { homeContent } from '../../lib/home';
import { areaRoute, focusAreas } from '../../lib/areas';
import LatestArticleCard from './LatestArticleCard.astro';
interface Props { entry: CollectionEntry<'sitePages'>; }
const { entry } = Astro.props;
const { latest } = await homeContent();
const tech = ['C++', 'TypeScript', 'WebAssembly', 'Swift', 'Metal', 'SDL3'];
const lab = [
  { title: 'Raster Playground', description: 'Tile-based canvas invalidation.', href: '/lab/#raster' },
  { title: 'Polygon Lab', description: 'Signed area and winding.', href: '/lab/#polygon' },
];
---

<section class="home-intro">
  <p class="eyebrow">PERSONAL ENGINEERING NOTEBOOK</p>
  <h1>{entry.data.heroTitle}</h1>
  <p class="lead">{entry.data.intro}</p>
  <ul class="tech-list" aria-label="Technologies">
    {tech.map((name) => <li>{name}</li>)}
  </ul>
</section>

<section class="home-section" aria-labelledby="latest-title">
  <header class="notes-head">
    <h2 id="latest-title">Latest articles</h2>
    <a href="/articles/">All articles →</a>
  </header>
  {latest.length ? (
    <div class="home-grid">{latest.map((article, index) => <LatestArticleCard article={article} priority={index === 0} />)}</div>
  ) : <p>New study notes and experiments will appear here.</p>}
</section>

<section class="home-section" aria-labelledby="topics-title">
  <header class="notes-head"><h2 id="topics-title">Explore by topic</h2></header>
  <div class="home-grid">
    {focusAreas.map((area, index) => (
      <a class="topic-card" href={areaRoute(area.id)}>
        <span class="topic-index">0{index + 1}</span>
        <h3>{area.label}</h3>
        <p>{area.description}</p>
      </a>
    ))}
  </div>
</section>

<section class="home-section" aria-labelledby="lab-title">
  <header class="notes-head"><h2 id="lab-title">Lab</h2><a href="/lab/">All experiments →</a></header>
  <div class="home-grid">
    {lab.map((item) => (
      <a class="topic-card" href={item.href}>
        <span class="topic-index">INTERACTIVE</span>
        <h3>{item.title}</h3><p>{item.description}</p>
      </a>
    ))}
  </div>
</section>

<style>
  .eyebrow { font: 600 .72rem/1.5 var(--font-mono); letter-spacing: .09em; color: var(--fg-muted); }
  .tech-list { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; padding: 0; margin: 1.5rem 0 0; }
  .tech-list li { border: 1px solid var(--border); border-radius: var(--radius-m); padding: .3rem .65rem; font: .78rem/1.5 var(--font-mono); color: var(--fg-muted); }
  .home-section { margin-bottom: var(--space-10); }
  .home-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .topic-card { min-width: 0; display: block; padding: 1.15rem; border: 1px solid var(--border); border-radius: var(--radius-m); color: var(--fg); background: var(--canvas); text-decoration: none; }
  .topic-card:hover { border-color: var(--action); text-decoration: none; }
  .topic-card:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .topic-index { font: .75rem/1.4 var(--font-mono); color: var(--fg-muted); }
  .topic-card h3 { font: 700 1.1rem/1.3 var(--font-heading); margin: .55rem 0; }
  .topic-card p { font-size: .875rem; line-height: 1.5; color: var(--fg-muted); margin: 0; }
  @media (max-width: 599px) { .home-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
