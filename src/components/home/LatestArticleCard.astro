---
import { Image } from 'astro:assets';
import type { Article } from '../../lib/articles';
import { articleUrl, interfaceLanguage } from '../../config/site';
import { articleCover } from '../../lib/covers';

interface Props {
  article: Article;
  priority?: boolean;
}
const { article, priority = false } = Astro.props;
const cover = await articleCover(article.data.cover);
---

<a class="featured-card" href={articleUrl(article)} data-analytics-label={article.data.title}>
  {cover && (
    <picture>
      {cover.dark && (
        <source
          srcset={cover.dark.srcSet.attribute || cover.dark.src}
          type="image/webp"
          sizes="(max-width: 599px) calc(100vw - 48px), 420px"
          media="(prefers-color-scheme: dark)"
        />
      )}
      <Image
        src={cover.src}
        widths={[320, 640, 960, 1200]}
        sizes="(max-width: 599px) calc(100vw - 48px), 420px"
        alt=""
        width={cover.width}
        height={cover.height}
        loading="eager"
        priority={priority}
      />
    </picture>
  )}
  <div class="featured-card__body">
    <p class="featured-card__label">{article.data.topicLabel}</p>
    <h3 lang={article.data.language}>{article.data.title}</h3>
    <p class="featured-card__description" lang={article.data.language}>
      {article.data.description}
    </p>
    <div class="featured-card__meta" lang={interfaceLanguage}>
      <time datetime={article.data.date.toISOString().slice(0, 10)}>{article.data.displayDate}</time>
      <span>{article.data.readingMinutes} min</span>
    </div>
  </div>
</a>

<style>
  .featured-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    color: var(--fg);
    background: var(--canvas);
    text-decoration: none;
  }
  .featured-card:hover {
    background: color-mix(in srgb, var(--apple-indigo) 5%, var(--canvas));
    border-color: var(--apple-indigo-text);
    color: var(--fg);
    text-decoration: none;
  }
  .featured-card:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  picture,
  img {
    display: block;
    width: 100%;
  }
  img {
    height: auto;
  }
  .featured-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.75rem;
    padding: 1.125rem;
  }
  p,
  h3 {
    margin: 0;
  }
  .featured-card__label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--apple-indigo-text);
  }
  h3 {
    font: 700 1.125rem/1.3 var(--font-heading);
    letter-spacing: -0.02em;
  }
  .featured-card__description {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--fg-muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .featured-card__meta {
    display: flex;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.25rem;
    color: var(--fg-muted);
    font: 0.75rem/1.4 var(--font-mono);
  }
</style>
