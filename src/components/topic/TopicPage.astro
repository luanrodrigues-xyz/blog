---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { interfaceLanguage, site, ui } from '../../config/site';
import type { Article } from '../../lib/articles';
import {
  availableCategories,
  topicArticles,
  tagsOf,
  topicName,
  topicRoute,
  topicSummary,
  type Topic,
} from '../../lib/topics';
import CategoryLinks from '../shared/CategoryLinks.astro';
import ArticleList from '../shared/ArticleList.astro';
interface Props {
  topic: Topic;
  articles: Article[];
}
const { topic, articles } = Astro.props;
const text = ui;
// Uma categoria só por assunto, com artigos dos dois idiomas editoriais: a UI continua em inglês.
const chosen = topicArticles(articles, topic);
// Tags de um artigo só (count 1) não ajudam a descobrir nada nesta categoria: só repetem o próprio artigo.
const tags = tagsOf(chosen).filter(({ count }) => count > 1);
const canonical = `${site.origin}${topicRoute(topic)}`;
---

<BaseLayout
  title={topicName(topic)}
  description={topicSummary(topic)}
  language={interfaceLanguage}
  canonical={canonical}
  isListingPage
  hasTopicTags={tags.length > 0}
>
  <div class="listing-page">
    <header class="page-header listing-head" lang={interfaceLanguage}>
      <p class="eyebrow">{text.category}</p>
      <h1>{topicName(topic)}</h1>
      <p class="lead">{topicSummary(topic)}</p>
      <p>
        {chosen.length} {chosen.length === 1 ? text.notesOne : text.notes}
      </p>
    </header>
    <div class="topic-categories">
      <CategoryLinks categories={availableCategories(articles)} active={topic.slug} showAll />
    </div>
    {tags.length > 0 && (
      <section class="topic-tags" aria-labelledby="topic-tags-title">
        <h2 id="topic-tags-title" lang={interfaceLanguage}>
          {text.topicTags}
        </h2>
        <ul class="topic-tags__list" role="list">
          {tags.map(({ tag, count }) => (
            <li>
              {tag}
              <span class="topic-tags__count">{count}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
    <ArticleList articles={chosen} showCategoryBadge={false} />
    <p class="listing-back">
      <a href={text.articlesUrl}>← {text.allArticles}</a>
    </p>
  </div>
</BaseLayout>

<style>
  .topic-categories {
    margin-bottom: var(--space-8);
  }
</style>
