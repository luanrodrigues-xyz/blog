---
import type { Game } from '../../data/games';
interface Props { game: Game; featured?: boolean }
const { game, featured = false } = Astro.props;
---
<article class:list={['game-card', {'game-card--featured': featured}]}>
  <a href={`/games/${game.slug}/`} class:list={['game-card__visual', `game-card__visual--${game.slug}`]} aria-label={`Explore ${game.title}`}>
    <span class="game-card__symbol" aria-hidden="true">{game.slug === 'tessora' ? '◇ ◢ ◆' : game.slug === 'ruptura' ? '↗ ◼' : '▣'}</span>
    <span class="game-card__visual-name" aria-hidden="true">{game.title}</span>
  </a>
  <div class="game-card__body">
    <div class="game-card__heading">
      <h3><a href={`/games/${game.slug}/`}>{game.title}</a></h3>
      <span class="game-card__status">{game.status}</span>
    </div>
    <p class="game-card__description">{game.description}</p>
    <ul class="game-card__tech" role="list">{game.technologies.map((tag) => <li>{tag}</li>)}</ul>
    <div class="game-card__links">
      {game.playUrl && <a href={game.playUrl} target="_blank" rel="noopener noreferrer">Play game ↗</a>}
      <a href={`/games/${game.slug}/`}>Project details →</a>
    </div>
  </div>
</article>
