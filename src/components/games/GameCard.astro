---
import { gameUrl, type Game } from '../../data/games';
import GameArt from './GameArt.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  game: Game;
  headingLevel?: 'h2' | 'h3';
}

const { game, headingLevel: Heading = 'h3' } = Astro.props;
const url = gameUrl(game);
---

<article class="card">
  <a href={url} tabindex="-1" aria-hidden="true">
    <GameArt game={game} flat />
  </a>
  <div class="card__body">
    <span class:list={['badge', `badge--${game.tone}`]}>{game.status}</span>
    <Heading class="card__title">
      <a href={url}>{game.title}</a>
    </Heading>
    <p class="card__tagline">{game.tagline}</p>
    <p class="card__text">{game.description}</p>
    <ul class="chips" aria-label="Technologies">
      {game.technologies.map((technology) => (
        <li class="chip">{technology}</li>
      ))}
    </ul>
    {game.playUrl ? (
      <a class="btn btn--primary btn--small" href={game.playUrl} rel="noopener noreferrer" target="_blank">
        <Icon name="play" size={16} />
        Play on itch.io
      </a>
    ) : (
      <a class="btn btn--small" href={url}>
        Enter the project
      </a>
    )}
  </div>
</article>
