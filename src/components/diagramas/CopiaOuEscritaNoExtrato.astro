---
// A mesma correção por dois caminhos (artigo structs-em-swift). Numa cópia, editada passa a ser um
// segundo valor e o extrato continua com -8_950; escrita por extrato[0], o próprio elemento muda e
// não há rascunho em outra variável. Duas composições: painéis lado a lado a partir de 540px de coluna;
// empilhados abaixo disso.
import Diagrama from './Diagrama.astro';
interface Props {
  rotulo: string;
}
const { rotulo } = Astro.props;

type Linha = { descricao: string; valor: string; mudou: boolean };
type Painel = { codigo: string[]; extrato: Linha[]; copia: Linha | null; nota: string };
const paineis: Painel[] = [
  {
    codigo: ['var editada = extrato[0]', 'editada.valor = -9_850'],
    extrato: [
      { descricao: 'Mercado', valor: '-8_950', mudou: false },
      { descricao: 'Tarifa', valor: '-1_290', mudou: false },
    ],
    copia: { descricao: 'Mercado', valor: '-9_850', mudou: true },
    nota: 'a correção ficou só na cópia',
  },
  {
    codigo: ['extrato[0].valor = -9_850'],
    extrato: [
      { descricao: 'Mercado', valor: '-9_850', mudou: true },
      { descricao: 'Tarifa', valor: '-1_290', mudou: false },
    ],
    copia: null,
    nota: 'a correção está no extrato',
  },
];

// Posições dentro de cada painel, em unidades do quadro (largura 1000). Na composição estreita as
// alturas são maiores: o quadro encolhe, mas a fonte tem piso de 13px.
const geometria = {
  largo: {
    w: 460,
    origens: [
      { x: 20, y: 20 },
      { x: 520, y: 20 },
    ],
    codigo: { y: 0, h: 90 },
    rotuloExtrato: { y: 110, h: 36 },
    linhas: [156, 226],
    hLinha: 60,
    rotuloCopia: { y: 306, h: 36 },
    copia: { y: 352 },
    nota: { y: 432, h: 60 },
    altura: 532,
    minLargura: 540,
  },
  estreito: {
    w: 960,
    origens: [
      { x: 20, y: 20 },
      { x: 20, y: 940 },
    ],
    codigo: { y: 0, h: 150 },
    rotuloExtrato: { y: 170, h: 70 },
    linhas: [250, 380],
    hLinha: 110,
    rotuloCopia: { y: 520, h: 70 },
    copia: { y: 600 },
    nota: { y: 730, h: 110 },
    altura: 1800,
    minLargura: 260,
  },
};
const pos = (x: number, y: number, w: number, h: number) => `--x:${x}; --y:${y}; --w:${w}; --h:${h}`;
---

<div class="copia-ou-escrita">
  {(['largo', 'estreito'] as const).map((layout) => {
    const g = geometria[layout];
    return (
      <div class={`composicao ${layout}`}>
        <Diagrama plano rotulo={rotulo} altura={g.altura} minLargura={g.minLargura}>
          <slot slot="legenda" />
          {paineis.map((p, i) => {
            const o = g.origens[i];
            return (
              <>
                <div class="no codigo" style={pos(o.x, o.y + g.codigo.y, g.w, g.codigo.h)}>
                  {p.codigo.map((linha) => (
                    <div class="t4">{linha}</div>
                  ))}
                </div>
                <div class="no pq ink2 rotulo" style={pos(o.x, o.y + g.rotuloExtrato.y, g.w, g.rotuloExtrato.h)}>
                  extrato
                </div>
                {p.extrato.map((linha, k) => (
                  <div
                    class:list={['no linha', { mudou: linha.mudou }]}
                    style={pos(o.x, o.y + g.linhas[k], g.w, g.hLinha)}
                  >
                    <div class="txt">{linha.descricao}</div>
                    <div class="t4">{linha.valor}</div>
                  </div>
                ))}
                <div class="no pq ink2 rotulo" style={pos(o.x, o.y + g.rotuloCopia.y, g.w, g.rotuloCopia.h)}>
                  {p.copia ? 'editada: cópia de extrato[0]' : 'sem variável de rascunho'}
                </div>
                {p.copia ? (
                  <div
                    class:list={['no linha', { mudou: p.copia.mudou }]}
                    style={pos(o.x, o.y + g.copia.y, g.w, g.hLinha)}
                  >
                    <div class="txt">{p.copia.descricao}</div>
                    <div class="t4">{p.copia.valor}</div>
                  </div>
                ) : null}
                <div class="no txt nota" style={pos(o.x, o.y + g.nota.y, g.w, g.nota.h)}>
                  {p.nota}
                </div>
              </>
            );
          })}
          <svg class="setas" viewBox={`0 0 1000 ${g.altura}`} aria-hidden="true" focusable="false">
            {layout === 'largo' ? (
              <line class="divisor" x1={500} y1={20} x2={500} y2={g.altura - 20} />
            ) : (
              <line class="divisor" x1={20} y1={890} x2={980} y2={890} />
            )}
          </svg>
        </Diagrama>
      </div>
    );
  })}
</div>

<style>
  .copia-ou-escrita {
    container-type: inline-size;
  }
  .composicao.estreito {
    display: none;
  }
  @container (max-width: 539px) {
    .composicao.largo {
      display: none;
    }
    .composicao.estreito {
      display: block;
    }
  }
  .divisor {
    stroke: var(--d-line);
    stroke-width: 1.5;
  }
  .codigo {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: calc(var(--u) * 6);
  }
  .codigo .t4 {
    line-height: 1.4;
  }
  .rotulo,
  .nota {
    display: flex;
    align-items: center;
  }
  .t4 {
    white-space: nowrap;
  }
  .linha {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 calc(var(--u) * 22);
    background: var(--d-card);
    border: 1px solid var(--d-line);
  }
  .linha.mudou {
    background: color-mix(in srgb, var(--d-blue) 12%, var(--d-card));
    border: 2px solid var(--d-blue);
  }
</style>
