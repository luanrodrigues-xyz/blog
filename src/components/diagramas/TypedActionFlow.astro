---
import Diagrama from './Diagrama.astro';
import Seta from './Seta.astro';
---
<Diagrama plano altura={660} rotulo="A ação openArticle carrega ArticleID swift-modeling. A função describe extrai esse identificador e retorna Open article swift-modeling. A descrição não executa navegação.">
  <div class="no nodo" style="--x:200; --y:40; --w:600; --h:150"><span class="t3">.openArticle(articleID)</span><span class="t4 ink2">rawValue = "swift-modeling"</span></div>
  <div class="no nodo" style="--x:200; --y:280; --w:600; --h:100"><span class="t3">describe(_ action: ArticleAction)</span></div>
  <div class="no nodo" style="--x:200; --y:470; --w:600; --h:130"><span class="pq ink2">String retornada</span><span class="t4">Open article swift-modeling</span></div>
  <svg class="setas" viewBox="0 0 1000 660" aria-hidden="true">
    <Seta x1={500} y1={190} x2={500} y2={280} tipo="neutra" />
    <Seta x1={500} y1={380} x2={500} y2={470} tipo="neutra" />
  </svg>
</Diagrama>
