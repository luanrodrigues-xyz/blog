---
import Diagrama from './Diagrama.astro';
import Seta from './Seta.astro';
const label =
  'Unrelated caller code can change PlayQueue only through its accessible operations. enqueue checks that an ID is nonempty before writing songIDs. A direct append from the caller is rejected because the setter is private. The boundary describes access, not memory layout.';
---

<div class="write-boundary">
  {[true, false].map((wide) => {
    const height = wide ? 850 : 1740;
    return (
      <div class:list={['composition', wide ? 'wide' : 'stacked']}>
        <Diagrama plano rotulo={label} altura={height} minLargura={260}>
          <div class="no txt heading" style={`--x:32;--y:24;--w:936;--h:${wide ? 60 : 120}`}>
            A caller's write paths
          </div>
          <div
            class="no nodo centered"
            style={`--x:32;--y:${wide ? 180 : 200};--w:${wide ? 330 : 936};--h:${wide ? 120 : 170}`}
          >
            <span class="pq">Allowed call</span>
            <span class="t4">enqueue("s1")</span>
          </div>
          <div
            class="no limite"
            style={`--x:${wide ? 480 : 32};--y:${wide ? 112 : 500};--w:${wide ? 488 : 936};--h:${wide ? 460 : 770}`}
          ></div>
          <div
            class="no txt heading"
            style={`--x:${wide ? 512 : 64};--y:${wide ? 132 : 530};--w:${wide ? 424 : 872};--h:${wide ? 60 : 100}`}
          >
            PlayQueue
          </div>
          <div
            class="no nodo centered"
            style={`--x:${wide ? 512 : 64};--y:${wide ? 216 : 660};--w:${wide ? 424 : 872};--h:${wide ? 110 : 200}`}
          >
            <span class="pq">enqueue checks the ID</span>
            <span class="t4">not empty</span>
          </div>
          <div
            class="no nodo centered"
            style={`--x:${wide ? 512 : 64};--y:${wide ? 424 : 950};--w:${wide ? 424 : 872};--h:${wide ? 110 : 200}`}
          >
            <span class="pq">stored array</span>
            <span class="t4">songIDs</span>
          </div>
          <div
            class="no nodo centered"
            style={`--x:32;--y:${wide ? 654 : 1340};--w:${wide ? 330 : 550};--h:${wide ? 120 : 230}`}
          >
            <span class="pq">Direct write</span>
            <span class="t4">append("")</span>
          </div>
          <div
            class="no pq centered"
            style={`--x:${wide ? 520 : 680};--y:${wide ? 654 : 1340};--w:${wide ? 416 : 288};--h:${wide ? 120 : 230}`}
          >
            Rejected
            <br />
            private setter
          </div>
          <svg class="setas" viewBox={`0 0 1000 ${height}`} aria-hidden="true" focusable="false">
            <Seta
              tipo="neutra"
              x1={wide ? 362 : 820}
              y1={wide ? 240 : 370}
              x2={wide ? 510 : 820}
              y2={wide ? 240 : 658}
            />
            <Seta
              tipo="neutra"
              x1={wide ? 724 : 500}
              y1={wide ? 326 : 860}
              x2={wide ? 724 : 500}
              y2={wide ? 422 : 948}
            />
            <line
              class="blocked"
              x1={wide ? 362 : 582}
              y1={wide ? 714 : 1455}
              x2={wide ? 452 : 646}
              y2={wide ? 714 : 1455}
            />
            <path class="stop" d={wide ? 'M440 698L464 730M464 698L440 730' : 'M634 1425L658 1485M658 1425L634 1485'} />
          </svg>
        </Diagrama>
      </div>
    );
  })}
</div>
<style>
  .write-boundary {
    container-type: inline-size;
  }
  .stacked {
    display: none;
  }
  @container (max-width:539px) {
    .wide {
      display: none;
    }
    .stacked {
      display: block;
    }
  }
  .heading,
  .centered {
    display: flex;
    align-items: center;
  }
  .heading {
    font-weight: 600;
  }
  .centered {
    justify-content: center;
    text-align: center;
  }
  .blocked,
  .stop {
    stroke: var(--d-vermelho);
    stroke-width: 3;
    fill: none;
    stroke-linecap: round;
  }
  .stacked .blocked,
  .stacked .stop {
    stroke-width: 6;
  }
  .stacked :global(.seta line) {
    stroke-width: 6;
  }
</style>
