---
import Diagrama from './Diagrama.astro';
import Seta from './Seta.astro';
const label =
  'Array preserves the three queue positions s1, s2, s1. Set contains the two unique IDs s1 and s2. Dictionary connects key s1 to Morning and key s2 to Evening. Set and Dictionary positions here do not represent iteration order.';
---

<div class="collections">
  {[true, false].map((wide) => {
    const height = wide ? 830 : 1680;
    const arrayY = wide ? 90 : 140;
    const setY = wide ? 350 : 650;
    const dictY = wide ? 610 : 1150;
    return (
      <div class:list={['composition', wide ? 'wide' : 'stacked']}>
        <Diagrama plano rotulo={label} altura={height} minLargura={260}>
          <div class="no txt heading" style={`--x:20;--y:20;--w:960;--h:${wide ? 60 : 100}`}>
            Array · queue positions
          </div>
          {['s1', 's2', 's1'].map((id, i) => (
            <div class="no nodo entry" style={`--x:${20 + i * 330};--y:${arrayY};--w:300;--h:${wide ? 110 : 230}`}>
              <span class="pq">index {i}</span>
              <span class="t4">{id}</span>
            </div>
          ))}
          <div class="no pq note" style={`--x:20;--y:${wide ? 220 : 390};--w:960;--h:${wide ? 50 : 100}`}>
            Three positions, including a repeat
          </div>
          <div class="no txt heading" style={`--x:20;--y:${wide ? 280 : 510};--w:960;--h:${wide ? 60 : 100}`}>
            Set · favorite membership
          </div>
          {['s1', 's2'].map((id, i) => (
            <div class="no nodo entry" style={`--x:${20 + i * 500};--y:${setY};--w:460;--h:${wide ? 110 : 180}`}>
              <span class="t4">{id}</span>
            </div>
          ))}
          <div class="no pq note" style={`--x:20;--y:${wide ? 480 : 860};--w:960;--h:${wide ? 50 : 150}`}>
            Two members, no defined order
          </div>
          <div class="no txt heading" style={`--x:20;--y:${wide ? 540 : 1020};--w:960;--h:${wide ? 60 : 100}`}>
            Dictionary · title by ID
          </div>
          {['Morning', 'Evening'].map((title, i) => {
            const x = wide ? 20 + i * 500 : 20;
            const y = wide ? dictY : dictY + i * 190;
            return (
              <>
                <div class="no nodo entry" style={`--x:${x};--y:${y};--w:${wide ? 110 : 240};--h:${wide ? 110 : 150}`}>
                  <span class="t4">s{i + 1}</span>
                </div>
                <div
                  class="no nodo entry"
                  style={`--x:${x + (wide ? 180 : 370)};--y:${y};--w:${wide ? 280 : 590};--h:${wide ? 110 : 150}`}
                >
                  <span class="t4">{title}</span>
                </div>
              </>
            );
          })}
          <div class="no pq note" style={`--x:20;--y:${wide ? 740 : 1540};--w:960;--h:${wide ? 60 : 100}`}>
            Each key maps to one value
          </div>
          <svg class="setas" viewBox={`0 0 1000 ${height}`} aria-hidden="true" focusable="false">
            {[0, 1].map((i) => (
              <Seta
                tipo="neutra"
                x1={wide ? 130 + i * 500 : 260}
                y1={wide ? dictY + 55 : dictY + i * 190 + 75}
                x2={wide ? 198 + i * 500 : 388}
                y2={wide ? dictY + 55 : dictY + i * 190 + 75}
              />
            ))}
          </svg>
        </Diagrama>
      </div>
    );
  })}
</div>
<style>
  .collections {
    container-type: inline-size;
  }
  .stacked {
    display: none;
  }
  @container (max-width: 539px) {
    .wide {
      display: none;
    }
    .stacked {
      display: block;
    }
  }
  .heading,
  .note {
    display: flex;
    align-items: center;
  }
  .heading {
    font-weight: 600;
  }
  .entry {
    align-items: center;
    text-align: center;
  }
  .stacked :global(.seta line) {
    stroke-width: 6;
  }
</style>
