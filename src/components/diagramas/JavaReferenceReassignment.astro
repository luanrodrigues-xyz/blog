---
import Diagrama from './Diagrama.astro';
import Seta from './Seta.astro';
const label =
  'Before reassignment, original and draft reference Stock A with quantity 10. After draft equals new Stock and draft quantity equals 3, original still references A with quantity 10, while draft references a separate Stock B with quantity 3. Other references are not redirected.';
---

<div class="reassignment">
  {[true, false].map((wide) => {
    const height = wide ? 990 : 2010;
    const before = wide ? 110 : 210;
    const after = wide ? 600 : 1290;
    const variableX = 20;
    const variableW = wide ? 320 : 360;
    const objectX = wide ? 590 : 510;
    const objectW = wide ? 390 : 470;
    const rowGap = wide ? 160 : 280;
    const nodeH = wide ? 110 : 230;
    return (
      <div class:list={['composition', wide ? 'wide' : 'stacked']}>
        <Diagrama plano rotulo={label} altura={height} minLargura={260}>
          <div class="no txt heading" style={`--x:20;--y:10;--w:960;--h:${wide ? 70 : 170}`}>
            Before · draft = original
          </div>
          {['original', 'draft'].map((name, i) => (
            <div
              class="no nodo value"
              style={`--x:${variableX};--y:${before + i * rowGap};--w:${variableW};--h:${nodeH}`}
            >
              <span class="t4">{name}</span>
            </div>
          ))}
          <div
            class="no nodo value"
            style={`--x:${objectX};--y:${before + (wide ? 40 : 50)};--w:${objectW};--h:${wide ? 200 : 340}`}
          >
            <span class="txt">Stock A</span>
            <span class="t4">quantity = 10</span>
          </div>
          <div class="no pq note" style={`--x:20;--y:${wide ? 430 : 800};--w:960;--h:${wide ? 110 : 280}`}>
            draft = new Stock()
            <br />
            draft.quantity = 3
          </div>
          <div class="no txt heading" style={`--x:20;--y:${wide ? 530 : 1090};--w:960;--h:${wide ? 60 : 170}`}>
            After · original keeps A
          </div>
          {['original', 'draft'].map((name, i) => (
            <>
              <div
                class="no nodo value"
                style={`--x:${variableX};--y:${after + i * rowGap};--w:${variableW};--h:${nodeH}`}
              >
                <span class="t4">{name}</span>
              </div>
              <div class="no nodo value" style={`--x:${objectX};--y:${after + i * rowGap};--w:${objectW};--h:${nodeH}`}>
                <span class="txt">Stock {i === 0 ? 'A' : 'B'}</span>
                <span class="t4">quantity = {i === 0 ? '10' : '3'}</span>
              </div>
            </>
          ))}
          <svg class="setas" viewBox={`0 0 1000 ${height}`} aria-hidden="true" focusable="false">
            {[0, 1].map((i) => (
              <>
                <Seta
                  tipo="neutra"
                  x1={variableX + variableW + 5}
                  y1={before + i * rowGap + nodeH / 2}
                  x2={objectX - 5}
                  y2={before + (wide ? 90 + i * 70 : 140 + i * 140)}
                />
                <Seta
                  tipo="neutra"
                  x1={variableX + variableW + 5}
                  y1={after + i * rowGap + nodeH / 2}
                  x2={objectX - 5}
                  y2={after + i * rowGap + nodeH / 2}
                />
              </>
            ))}
          </svg>
        </Diagrama>
      </div>
    );
  })}
</div>
<style>
  .reassignment {
    container-type: inline-size;
  }
  .stacked {
    display: none;
  }
  @container (max-width:599px) {
    .wide {
      display: none;
    }
    .stacked {
      display: block;
    }
  }
  .heading,
  .note {
    display: flex;
    align-items: center;
  }
  .note {
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
  .heading {
    font-weight: 600;
  }
  .value {
    align-items: center;
    text-align: center;
  }
  .stacked :global(.seta line) {
    stroke-width: 6;
  }
</style>
