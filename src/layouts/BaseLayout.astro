---
import { ClientRouter } from 'astro:transitions';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import { site } from '../config/site';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  /** Home uses the brand title alone; every other page gets "<title> · Art by Luan". */
  isHome?: boolean;
  ogType?: 'website' | 'article';
  canonical?: string | null;
  noindex?: boolean;
}

const {
  title,
  description,
  isHome = false,
  ogType = 'website',
  canonical: canonicalProp,
  noindex = false,
} = Astro.props;
const canonical =
  canonicalProp === null ? undefined : (canonicalProp ?? new URL(Astro.url.pathname, site.origin).toString());
const titleText = isHome
  ? `${site.name} | Concept Artist, Illustrator & Indie Game Developer`
  : `${title} · ${site.name}`;
const socialImage = `${site.origin}/og-default.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titleText}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={isHome ? titleText : title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Art by Luan: two illustrated characters on the steps of Silicon City." />
    <meta property="og:locale" content="en_US" />
    <meta name="author" content={site.author} />
    <meta name="theme-color" content="#f4e8da" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={isHome ? titleText : title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap"
    />
    <ClientRouter />
    <GoogleAnalytics />
  </head>
  <body>
    <GoogleAnalytics noscript />
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
